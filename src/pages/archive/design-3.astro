---
const title = "Elm Lake | Wisconsin Heritage & Innovation";
const description = "Gateway to Elm Lake Cranberry and Elm Lake Labs - where four generations of Wisconsin heritage meets modern innovation.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Fonts - Organic natural feel -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;1,9..144,400&family=Karla:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="organic-bg">
			<svg class="blob blob-1" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
				<path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.5,90,-16.3,88.5,-0.9C87,14.5,81.4,29,73.1,41.8C64.8,54.6,53.8,65.7,40.8,73.5C27.8,81.3,12.9,85.8,-1.7,88.7C-16.3,91.6,-32.7,92.9,-46.6,86.2C-60.5,79.5,-71.9,64.8,-79.1,48.6C-86.3,32.4,-89.3,14.7,-87.9,-2.4C-86.5,-19.5,-80.7,-36.1,-70.5,-49.3C-60.3,-62.5,-45.7,-72.3,-30.5,-78.6C-15.3,-84.9,0.5,-87.7,15.8,-84.5C31.1,-81.3,62,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
			</svg>
			<svg class="blob blob-2" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
				<path fill="currentColor" d="M39.9,-65.7C52.1,-60.1,62.6,-50.2,70.2,-38.1C77.8,-26,82.5,-11.7,81.2,1.9C79.9,15.4,72.7,28.2,63.6,38.8C54.5,49.4,43.5,57.8,31.3,63.5C19.1,69.2,5.7,72.2,-8.4,73.2C-22.5,74.2,-37.3,73.2,-49.4,67C-61.5,60.8,-70.9,49.4,-76.4,36.3C-81.9,23.2,-83.5,8.4,-81.5,-5.6C-79.5,-19.6,-73.9,-32.8,-64.8,-43.3C-55.7,-53.8,-43.1,-61.6,-30.1,-66.8C-17.1,-72,-4.3,-74.6,7.3,-73.2C18.9,-71.8,37.7,-66.4,39.9,-65.7Z" transform="translate(100 100)" />
			</svg>
			<svg class="blob blob-3" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
				<path fill="currentColor" d="M47.7,-79.1C62.3,-72.3,74.8,-60.4,82.1,-45.9C89.4,-31.4,91.5,-14.2,89.6,2.1C87.7,18.4,81.8,33.9,72.5,47C63.2,60.1,50.5,70.8,36.2,77.3C21.9,83.8,6,86.1,-9.3,84.1C-24.6,82.1,-39.3,75.8,-51.8,66.5C-64.3,57.2,-74.6,44.9,-80.7,30.6C-86.8,16.3,-88.7,0,-85.4,-14.8C-82.1,-29.6,-73.6,-42.9,-62.2,-52.8C-50.8,-62.7,-36.5,-69.2,-22.2,-74.4C-7.9,-79.6,6.4,-83.5,20.9,-82.8C35.4,-82.1,50.1,-76.8,47.7,-79.1Z" transform="translate(100 100)" />
			</svg>
		</div>

		<a href="/" class="back-link">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M19 12H5"/>
				<path d="M12 19l-7-7 7-7"/>
			</svg>
			Back to Original
		</a>

		<main>
			<header class="hero">
				<div class="hero-badge">
					<span>Wisconsin</span>
					<span class="badge-dot"></span>
					<span>Since 1901</span>
				</div>
				<h1>
					<span class="hero-word">Elm</span>
					<span class="hero-word hero-accent">Lake</span>
				</h1>
				<p class="hero-tagline">Where roots run deep & ideas take flight</p>
			</header>

			<section class="ventures">
				<a href="https://elmlakecranberry.com" class="venture cranberry" target="_blank" rel="noopener">
					<div class="venture-visual">
						<div class="venture-circle">
							<img src="/images/ELC/logo.png" alt="Elm Lake Cranberry" />
						</div>
						<div class="venture-ring"></div>
					</div>
					<div class="venture-info">
						<span class="venture-label">Agriculture</span>
						<h2>Elm Lake Cranberry</h2>
						<p>Four generations of cranberry farming in Wisconsin's pristine marshlands. Proud grower-owners with Ocean Spray.</p>
						<span class="venture-cta">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<path d="M12 8l4 4-4 4"/>
								<path d="M8 12h8"/>
							</svg>
						</span>
					</div>
				</a>

				<div class="venture-connector">
					<div class="connector-line"></div>
					<span class="connector-text">Heritage & Innovation</span>
					<div class="connector-line"></div>
				</div>

				<a href="https://elmlakelabs.com" class="venture labs" target="_blank" rel="noopener">
					<div class="venture-visual">
						<div class="venture-circle">
							<img src="/images/ELL/logo.png" alt="Elm Lake Labs" />
						</div>
						<div class="venture-ring"></div>
					</div>
					<div class="venture-info">
						<span class="venture-label">Technology</span>
						<h2>Elm Lake Labs</h2>
						<p>Building modern software solutions with the same care and craftsmanship that defines our agricultural heritage.</p>
						<span class="venture-cta">
							Explore
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<path d="M12 8l4 4-4 4"/>
								<path d="M8 12h8"/>
							</svg>
						</span>
					</div>
				</a>
			</section>

			<footer>
				<div class="footer-wave">
					<svg viewBox="0 0 1200 120" preserveAspectRatio="none">
						<path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"></path>
					</svg>
				</div>
				<p>Cranmoor, Wisconsin</p>
			</footer>
		</main>
	</body>
</html>

<style>
	:root {
		--sage: #8FAE8B;
		--sage-light: #B8CDB5;
		--sage-dark: #5C7A58;
		--forest: #2D4A3E;
		--cream: #FBF9F4;
		--warm-white: #FFFEF9;
		--bark: #4A3728;
		--cranberry: #8B2635;
		--berry-light: #C45C6A;
		--sky: #7BA3C4;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-size: 16px;
	}

	body {
		font-family: 'Karla', sans-serif;
		background: linear-gradient(180deg, var(--warm-white) 0%, var(--cream) 50%, var(--sage-light) 100%);
		color: var(--bark);
		min-height: 100vh;
		overflow-x: hidden;
		position: relative;
	}

	/* Organic Background Blobs */
	.organic-bg {
		position: fixed;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		z-index: 0;
	}

	.blob {
		position: absolute;
		opacity: 0.08;
	}

	.blob-1 {
		width: 60vw;
		height: 60vw;
		top: -20%;
		right: -15%;
		color: var(--sage);
		animation: float 25s ease-in-out infinite;
	}

	.blob-2 {
		width: 50vw;
		height: 50vw;
		bottom: -10%;
		left: -20%;
		color: var(--cranberry);
		animation: float 30s ease-in-out infinite reverse;
	}

	.blob-3 {
		width: 40vw;
		height: 40vw;
		top: 40%;
		left: 50%;
		transform: translateX(-50%);
		color: var(--sky);
		animation: float 20s ease-in-out infinite;
		animation-delay: -5s;
	}

	@keyframes float {
		0%, 100% { transform: translate(0, 0) rotate(0deg); }
		25% { transform: translate(2%, 3%) rotate(5deg); }
		50% { transform: translate(-1%, 5%) rotate(-3deg); }
		75% { transform: translate(-3%, 2%) rotate(2deg); }
	}

	.back-link {
		position: fixed;
		top: 1.5rem;
		left: 1.5rem;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1rem;
		background: white;
		border-radius: 100px;
		color: var(--forest);
		text-decoration: none;
		font-size: 0.8rem;
		font-weight: 500;
		box-shadow: 0 4px 20px rgba(0,0,0,0.08);
		transition: all 0.3s ease;
	}

	.back-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 25px rgba(0,0,0,0.12);
	}

	main {
		position: relative;
		z-index: 1;
		max-width: 1200px;
		margin: 0 auto;
		padding: 4rem 2rem;
	}

	/* Hero */
	.hero {
		text-align: center;
		padding: 4rem 0 5rem;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 1.25rem;
		background: white;
		border-radius: 100px;
		margin-bottom: 2rem;
		box-shadow: 0 4px 20px rgba(0,0,0,0.06);
		animation: slideDown 0.8s ease-out;
	}

	.hero-badge span {
		font-size: 0.7rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--forest);
	}

	.badge-dot {
		width: 4px;
		height: 4px;
		background: var(--cranberry);
		border-radius: 50%;
	}

	.hero h1 {
		font-family: 'Fraunces', serif;
		font-size: clamp(4rem, 12vw, 8rem);
		font-weight: 300;
		line-height: 0.95;
		margin-bottom: 1.5rem;
		animation: fadeUp 1s ease-out 0.2s backwards;
	}

	.hero-word {
		display: block;
	}

	.hero-accent {
		color: var(--sage-dark);
		font-style: italic;
		font-weight: 500;
	}

	.hero-tagline {
		font-family: 'Fraunces', serif;
		font-size: 1.1rem;
		font-style: italic;
		color: var(--sage-dark);
		animation: fadeUp 1s ease-out 0.4s backwards;
	}

	/* Ventures */
	.ventures {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		align-items: center;
	}

	.venture {
		display: flex;
		align-items: center;
		gap: 3rem;
		padding: 2.5rem;
		background: rgba(255,255,255,0.7);
		backdrop-filter: blur(20px);
		border-radius: 24px;
		text-decoration: none;
		color: inherit;
		width: 100%;
		max-width: 700px;
		transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 8px 40px rgba(0,0,0,0.06);
		animation: fadeUp 0.8s ease-out backwards;
	}

	.venture.cranberry { animation-delay: 0.5s; }
	.venture.labs { animation-delay: 0.7s; }

	.venture:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 60px rgba(0,0,0,0.1);
		background: rgba(255,255,255,0.9);
	}

	.venture-visual {
		position: relative;
		flex-shrink: 0;
	}

	.venture-circle {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 2;
		transition: transform 0.5s ease;
	}

	.cranberry .venture-circle {
		background: linear-gradient(135deg, var(--cranberry) 0%, var(--berry-light) 100%);
	}

	.labs .venture-circle {
		background: linear-gradient(135deg, var(--forest) 0%, var(--sage-dark) 100%);
	}

	.venture:hover .venture-circle {
		transform: scale(1.05);
	}

	.venture-circle img {
		width: 60%;
		height: auto;
		filter: brightness(0) invert(1);
	}

	.venture-ring {
		position: absolute;
		inset: -8px;
		border-radius: 50%;
		border: 2px dashed;
		opacity: 0.3;
		animation: spin 30s linear infinite;
	}

	.cranberry .venture-ring { border-color: var(--cranberry); }
	.labs .venture-ring { border-color: var(--forest); }

	@keyframes spin {
		to { transform: rotate(360deg); }
	}

	.venture-info {
		flex: 1;
	}

	.venture-label {
		display: inline-block;
		font-size: 0.65rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		padding: 0.3rem 0.8rem;
		border-radius: 100px;
		margin-bottom: 0.75rem;
	}

	.cranberry .venture-label {
		background: rgba(139, 38, 53, 0.1);
		color: var(--cranberry);
	}

	.labs .venture-label {
		background: rgba(45, 74, 62, 0.1);
		color: var(--forest);
	}

	.venture-info h2 {
		font-family: 'Fraunces', serif;
		font-size: 1.75rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
	}

	.venture-info p {
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--bark);
		opacity: 0.75;
		margin-bottom: 1rem;
	}

	.venture-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 500;
		transition: gap 0.3s ease;
	}

	.cranberry .venture-cta { color: var(--cranberry); }
	.labs .venture-cta { color: var(--forest); }

	.venture:hover .venture-cta {
		gap: 0.75rem;
	}

	/* Connector */
	.venture-connector {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 1rem 0;
		animation: fadeIn 1s ease-out 0.6s backwards;
	}

	.connector-line {
		width: 60px;
		height: 1px;
		background: linear-gradient(90deg, transparent, var(--sage-dark), transparent);
	}

	.connector-text {
		font-family: 'Fraunces', serif;
		font-size: 0.85rem;
		font-style: italic;
		color: var(--sage-dark);
		white-space: nowrap;
	}

	/* Footer */
	footer {
		text-align: center;
		margin-top: 4rem;
		position: relative;
	}

	.footer-wave {
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%);
		width: 200px;
		height: 20px;
		opacity: 0.2;
	}

	.footer-wave svg {
		width: 100%;
		height: 100%;
		fill: var(--sage-dark);
	}

	footer p {
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--sage-dark);
	}

	/* Animations */
	@keyframes slideDown {
		from {
			opacity: 0;
			transform: translateY(-20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	/* Mobile */
	@media (max-width: 768px) {
		main {
			padding: 5rem 1rem 3rem;
		}

		.venture {
			flex-direction: column;
			text-align: center;
			gap: 1.5rem;
			padding: 2rem 1.5rem;
		}

		.venture-circle {
			width: 100px;
			height: 100px;
		}

		.venture-connector {
			flex-direction: column;
			gap: 0.5rem;
		}

		.connector-line {
			width: 1px;
			height: 30px;
			background: linear-gradient(180deg, transparent, var(--sage-dark), transparent);
		}
	}
</style>
