---
const title = "Elm Lake | Wisconsin Heritage & Innovation";
const description = "Gateway to Elm Lake Cranberry and Elm Lake Labs - where four generations of Wisconsin heritage meets modern innovation.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Fonts - Editorial luxury -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,700;1,6..96,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="noise"></div>

		<a href="/" class="back-link">
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M19 12H5"/>
				<path d="M12 19l-7-7 7-7"/>
			</svg>
			Back
		</a>

		<nav class="top-nav">
			<span class="nav-item">Heritage</span>
			<span class="nav-divider">/</span>
			<span class="nav-item">Innovation</span>
		</nav>

		<main>
			<header class="masthead">
				<div class="masthead-content">
					<span class="issue-number">Est. 1901</span>
					<h1>
						<span class="title-line">Elm</span>
						<span class="title-line title-italic">Lake</span>
					</h1>
					<p class="masthead-sub">Cranmoor, Wisconsin</p>
				</div>
			</header>

			<section class="editorial-grid">
				<article class="feature feature-cranberry">
					<a href="https://elmlakecranberry.com" target="_blank" rel="noopener" class="feature-link">
						<div class="feature-image">
							<img src="/images/ELC/logo.png" alt="Elm Lake Cranberry" />
							<div class="image-overlay"></div>
						</div>
						<div class="feature-content">
							<span class="feature-category">Agriculture</span>
							<h2>Elm Lake Cranberry</h2>
							<p class="feature-excerpt">
								Four generations of cranberry farming in Wisconsin's pristine marshlands.
								Proud grower-owners with Ocean Spray, cultivating excellence for over a century.
							</p>
							<div class="feature-meta">
								<span class="read-more">Visit Site</span>
								<span class="arrow">→</span>
							</div>
						</div>
					</a>
				</article>

				<div class="editorial-divider">
					<span class="divider-text">Two Ventures</span>
					<span class="divider-text">One Legacy</span>
				</div>

				<article class="feature feature-labs">
					<a href="https://elmlakelabs.com" target="_blank" rel="noopener" class="feature-link">
						<div class="feature-image">
							<img src="/images/ELL/logo.png" alt="Elm Lake Labs" />
							<div class="image-overlay"></div>
						</div>
						<div class="feature-content">
							<span class="feature-category">Technology</span>
							<h2>Elm Lake Labs</h2>
							<p class="feature-excerpt">
								Building modern software solutions with the same care and craftsmanship
								that defines our agricultural heritage. Thoughtful technology for real problems.
							</p>
							<div class="feature-meta">
								<span class="read-more">Visit Site</span>
								<span class="arrow">→</span>
							</div>
						</div>
					</a>
				</article>
			</section>

			<footer class="colophon">
				<div class="colophon-line"></div>
				<p>A Family Enterprise</p>
			</footer>
		</main>
	</body>
</html>

<style>
	:root {
		--black: #0D0D0D;
		--charcoal: #1A1A1A;
		--smoke: #2A2A2A;
		--silver: #8A8A8A;
		--pearl: #E8E8E8;
		--white: #FAFAFA;
		--gold: #C4A456;
		--cranberry: #8B2635;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-size: 16px;
	}

	body {
		font-family: 'Jost', sans-serif;
		background: var(--black);
		color: var(--pearl);
		min-height: 100vh;
		line-height: 1.6;
		overflow-x: hidden;
	}

	/* Film grain texture */
	.noise {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1000;
		opacity: 0.04;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
	}

	.back-link {
		position: fixed;
		top: 2rem;
		left: 2rem;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--silver);
		text-decoration: none;
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		transition: color 0.3s ease;
	}

	.back-link:hover {
		color: var(--white);
	}

	.top-nav {
		position: fixed;
		top: 2rem;
		right: 2rem;
		z-index: 100;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.nav-item {
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--silver);
	}

	.nav-divider {
		color: var(--smoke);
	}

	main {
		max-width: 1400px;
		margin: 0 auto;
		padding: 8rem 4rem 4rem;
	}

	/* Masthead */
	.masthead {
		text-align: center;
		margin-bottom: 6rem;
		padding-bottom: 4rem;
		border-bottom: 1px solid var(--smoke);
	}

	.masthead-content {
		animation: fadeIn 1.2s ease-out;
	}

	.issue-number {
		display: inline-block;
		font-size: 0.65rem;
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 2rem;
		padding: 0.5rem 1.5rem;
		border: 1px solid var(--gold);
	}

	.masthead h1 {
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(4rem, 15vw, 12rem);
		font-weight: 400;
		line-height: 0.85;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
	}

	.title-line {
		display: block;
	}

	.title-italic {
		font-style: italic;
		color: var(--gold);
	}

	.masthead-sub {
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--silver);
	}

	/* Editorial Grid */
	.editorial-grid {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 3rem;
		align-items: start;
	}

	.feature {
		animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
	}

	.feature-cranberry {
		animation-delay: 0.3s;
	}

	.feature-labs {
		animation-delay: 0.5s;
	}

	.feature-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.feature-image {
		position: relative;
		aspect-ratio: 4/3;
		background: var(--charcoal);
		margin-bottom: 2rem;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.feature-image img {
		width: 50%;
		max-width: 180px;
		height: auto;
		object-fit: contain;
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		z-index: 2;
	}

	.image-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.3) 100%);
		z-index: 1;
	}

	.feature-link:hover .feature-image img {
		transform: scale(1.1);
	}

	.feature-category {
		display: inline-block;
		font-size: 0.6rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gold);
		margin-bottom: 1rem;
	}

	.feature-content h2 {
		font-family: 'Bodoni Moda', serif;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 400;
		margin-bottom: 1rem;
		line-height: 1.2;
		transition: color 0.3s ease;
	}

	.feature-link:hover h2 {
		color: var(--gold);
	}

	.feature-excerpt {
		font-size: 0.9rem;
		line-height: 1.8;
		color: var(--silver);
		margin-bottom: 2rem;
		font-weight: 300;
	}

	.feature-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--smoke);
	}

	.read-more {
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--pearl);
	}

	.arrow {
		font-size: 1.25rem;
		color: var(--gold);
		transition: transform 0.3s ease;
	}

	.feature-link:hover .arrow {
		transform: translateX(8px);
	}

	/* Editorial Divider */
	.editorial-divider {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 2rem 0;
		animation: fadeIn 1s ease-out 0.7s backwards;
	}

	.divider-text {
		font-family: 'Bodoni Moda', serif;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--silver);
		writing-mode: vertical-rl;
		text-orientation: mixed;
		letter-spacing: 0.1em;
	}

	/* Colophon */
	.colophon {
		margin-top: 6rem;
		padding-top: 3rem;
		text-align: center;
	}

	.colophon-line {
		width: 40px;
		height: 1px;
		background: var(--gold);
		margin: 0 auto 2rem;
	}

	.colophon p {
		font-size: 0.65rem;
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: var(--silver);
	}

	/* Animations */
	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(60px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Mobile */
	@media (max-width: 1024px) {
		.editorial-grid {
			grid-template-columns: 1fr;
			gap: 4rem;
		}

		.editorial-divider {
			flex-direction: row;
			writing-mode: horizontal-tb;
		}

		.divider-text {
			writing-mode: horizontal-tb;
		}
	}

	@media (max-width: 768px) {
		main {
			padding: 6rem 1.5rem 3rem;
		}

		.back-link {
			top: 1rem;
			left: 1rem;
		}

		.top-nav {
			display: none;
		}

		.masthead {
			margin-bottom: 4rem;
		}
	}
</style>
