---
const title = "Elm Lake | Wisconsin Heritage & Innovation";
const description = "Gateway to Elm Lake Cranberry and Elm Lake Labs - where four generations of Wisconsin heritage meets modern innovation.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://elmlake.com" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
	</head>
	<body>
		<div class="grain"></div>

		<main>
			<header class="hero">
				<div class="hero-content">
					<p class="tagline">Wisconsin</p>
					<h1>Elm Lake</h1>
					<p class="subtitle">Heritage & Innovation</p>
				</div>
			</header>

			<section class="ventures">
				<div class="venture-grid">
					<a href="https://elmlakecranberry.com" class="venture-card cranberry" target="_blank" rel="noopener">
						<div class="card-inner">
							<div class="card-logo">
								<img src="/images/elm-lake-cranberry-logo.png" alt="Elm Lake Cranberry logo" />
							</div>
							<div class="card-content">
								<h2>Elm Lake Cranberry</h2>
								<p class="established">Est. 1901</p>
								<p class="description">
									Four generations of cranberry farming in Wisconsin's pristine marshlands.
									Proud grower-owners with Ocean Spray, cultivating excellence for over a century.
								</p>
								<span class="card-link">
									Visit Site
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M7 17L17 7"/>
										<path d="M7 7h10v10"/>
									</svg>
								</span>
							</div>
						</div>
						<div class="card-bg"></div>
					</a>

					<a href="https://elmlakelabs.com" class="venture-card labs" target="_blank" rel="noopener">
						<div class="card-inner">
							<div class="card-logo">
								<div class="labs-logo">
									<span class="labs-icon">◈</span>
								</div>
							</div>
							<div class="card-content">
								<h2>Elm Lake Labs</h2>
								<p class="established">Technology Studio</p>
								<p class="description">
									Building modern software solutions with the same care and craftsmanship
									that defines our agricultural heritage. Thoughtful technology for real problems.
								</p>
								<span class="card-link">
									Visit Site
									<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M7 17L17 7"/>
										<path d="M7 7h10v10"/>
									</svg>
								</span>
							</div>
						</div>
						<div class="card-bg"></div>
					</a>
				</div>
			</section>

			<footer>
				<p>Cranmoor, Wisconsin</p>
			</footer>
		</main>
	</body>
</html>

<style>
	:root {
		/* Colors */
		--color-cream: #FAF7F2;
		--color-cream-dark: #F0EBE3;
		--color-ink: #1A1915;
		--color-ink-light: #3D3A33;
		--color-cranberry: #8B2635;
		--color-cranberry-dark: #6B1D28;
		--color-forest: #2D4A3E;
		--color-forest-light: #3D5F50;
		--color-slate: #4A5568;
		--color-azure: #2C3E50;
		--color-azure-light: #34495E;

		/* Typography */
		--font-display: 'Cormorant Garamond', Georgia, serif;
		--font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;

		/* Spacing */
		--space-xs: 0.5rem;
		--space-sm: 1rem;
		--space-md: 2rem;
		--space-lg: 4rem;
		--space-xl: 6rem;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-size: 16px;
	}

	body {
		font-family: var(--font-body);
		background: var(--color-cream);
		color: var(--color-ink);
		min-height: 100vh;
		line-height: 1.6;
		overflow-x: hidden;
	}

	/* Subtle grain texture overlay */
	.grain {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		opacity: 0.03;
		z-index: 1000;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
	}

	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* Hero Section */
	.hero {
		text-align: center;
		padding: var(--space-xl) var(--space-md) var(--space-lg);
		position: relative;
	}

	.hero::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 1px;
		height: 60px;
		background: linear-gradient(to bottom, transparent, var(--color-ink-light));
		opacity: 0.3;
	}

	.hero-content {
		animation: fadeUp 1s ease-out;
	}

	.tagline {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--color-slate);
		margin-bottom: var(--space-sm);
	}

	.hero h1 {
		font-family: var(--font-display);
		font-size: clamp(3.5rem, 12vw, 7rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1;
		color: var(--color-ink);
	}

	.subtitle {
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 3vw, 1.5rem);
		font-weight: 400;
		font-style: italic;
		color: var(--color-ink-light);
		margin-top: var(--space-xs);
	}

	/* Ventures Section */
	.ventures {
		flex: 1;
		padding: 0 var(--space-md) var(--space-lg);
	}

	.venture-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-md);
		max-width: 1200px;
		margin: 0 auto;
	}

	@media (max-width: 768px) {
		.venture-grid {
			grid-template-columns: 1fr;
			gap: var(--space-sm);
		}
	}

	/* Venture Cards */
	.venture-card {
		position: relative;
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: 16px;
		overflow: hidden;
		min-height: 400px;
		animation: fadeUp 1s ease-out backwards;
	}

	.venture-card:nth-child(1) {
		animation-delay: 0.2s;
	}

	.venture-card:nth-child(2) {
		animation-delay: 0.4s;
	}

	.card-inner {
		position: relative;
		z-index: 2;
		height: 100%;
		padding: var(--space-lg) var(--space-md);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}

	.card-bg {
		position: absolute;
		inset: 0;
		z-index: 1;
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.venture-card:hover .card-bg {
		transform: scale(1.02);
	}

	/* Cranberry Card */
	.cranberry .card-bg {
		background: linear-gradient(145deg, var(--color-cranberry) 0%, var(--color-cranberry-dark) 50%, var(--color-forest) 100%);
	}

	.cranberry {
		color: var(--color-cream);
	}

	.cranberry .card-logo img {
		width: 140px;
		height: auto;
		filter: brightness(0) invert(1);
		opacity: 0.95;
		transition: transform 0.4s ease;
	}

	.cranberry:hover .card-logo img {
		transform: scale(1.05);
	}

	/* Labs Card */
	.labs .card-bg {
		background: linear-gradient(145deg, var(--color-azure) 0%, var(--color-azure-light) 50%, var(--color-ink) 100%);
	}

	.labs {
		color: var(--color-cream);
	}

	.labs-logo {
		width: 80px;
		height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		transition: all 0.4s ease;
	}

	.labs:hover .labs-logo {
		background: rgba(255, 255, 255, 0.15);
		transform: scale(1.05);
	}

	.labs-icon {
		font-size: 2rem;
		opacity: 0.9;
	}

	/* Card Content */
	.card-content h2 {
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 4vw, 2.25rem);
		font-weight: 500;
		margin-bottom: var(--space-xs);
		letter-spacing: -0.01em;
	}

	.established {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		opacity: 0.7;
		margin-bottom: var(--space-sm);
	}

	.description {
		font-size: 0.95rem;
		line-height: 1.7;
		opacity: 0.85;
		max-width: 380px;
		margin-bottom: var(--space-md);
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		opacity: 0.9;
		transition: all 0.3s ease;
	}

	.card-link svg {
		transition: transform 0.3s ease;
	}

	.venture-card:hover .card-link {
		opacity: 1;
	}

	.venture-card:hover .card-link svg {
		transform: translate(3px, -3px);
	}

	/* Footer */
	footer {
		text-align: center;
		padding: var(--space-md);
		position: relative;
	}

	footer::before {
		content: '';
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%);
		width: 40px;
		height: 1px;
		background: var(--color-ink-light);
		opacity: 0.2;
	}

	footer p {
		font-family: var(--font-body);
		font-size: 0.75rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-slate);
	}

	/* Animations */
	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Hover effects for desktop */
	@media (hover: hover) {
		.venture-card {
			transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.venture-card:hover {
			transform: translateY(-4px);
		}
	}

	/* Mobile adjustments */
	@media (max-width: 768px) {
		.hero {
			padding: var(--space-lg) var(--space-sm) var(--space-md);
		}

		.hero::before {
			height: 40px;
		}

		.ventures {
			padding: 0 var(--space-sm) var(--space-md);
		}

		.venture-card {
			min-height: 340px;
		}

		.card-inner {
			padding: var(--space-md) var(--space-sm);
		}

		.cranberry .card-logo img {
			width: 100px;
		}

		.labs-logo {
			width: 60px;
			height: 60px;
		}

		.labs-icon {
			font-size: 1.5rem;
		}
	}
</style>
