---
const title = "Elm Lake | Wisconsin Heritage & Innovation";
const description = "Gateway to Elm Lake Cranberry and Elm Lake Labs - where four generations of Wisconsin heritage meets modern innovation.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Fonts - Elegant contrast pairing -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Outfit:wght@300;400;500&display=swap" rel="stylesheet">
	</head>
	<body>
		<main class="split-container">
			<!-- Left Panel - Cranberry -->
			<a href="https://elmlakecranberry.com" class="panel panel-left" target="_blank" rel="noopener">
				<div class="panel-bg"></div>
				<div class="panel-content">
					<div class="logo-container">
						<img src="/images/ELC/logo-white.png" alt="Elm Lake Cranberry" class="logo" />
					</div>
					<div class="text-content">
						<span class="label">Since 1901</span>
						<h2>Elm Lake<br/>Cranberry</h2>
						<p>Four generations cultivating Wisconsin's pristine marshlands. Grower-owners with Ocean Spray.</p>
						<span class="cta">
							Explore Heritage
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"/>
								<path d="M12 5l7 7-7 7"/>
							</svg>
						</span>
					</div>
				</div>
				<div class="hover-reveal">
					<span>Visit Site</span>
				</div>
			</a>

			<!-- Center Divider -->
			<div class="center-brand">
				<div class="brand-vertical">
					<span class="brand-text">Elm Lake</span>
					<span class="brand-sub">Wisconsin</span>
				</div>
			</div>

			<!-- Right Panel - Labs -->
			<a href="https://elmlakelabs.com" class="panel panel-right" target="_blank" rel="noopener">
				<div class="panel-bg"></div>
				<div class="panel-content">
					<div class="logo-container">
						<img src="/images/ELL/logo-white.png" alt="Elm Lake Labs" class="logo" />
					</div>
					<div class="text-content">
						<span class="label">Technology Studio</span>
						<h2>Elm Lake<br/>Labs</h2>
						<p>Modern software solutions with the care and craftsmanship of our agricultural heritage.</p>
						<span class="cta">
							Explore Innovation
							<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M5 12h14"/>
								<path d="M12 5l7 7-7 7"/>
							</svg>
						</span>
					</div>
				</div>
				<div class="hover-reveal">
					<span>Visit Site</span>
				</div>
			</a>
		</main>

		<footer>
			<span>Cranmoor, Wisconsin</span>
		</footer>
	</body>
</html>

<style>
	:root {
		--cranberry: #722F37;
		--cranberry-deep: #4A1F24;
		--midnight: #0A0F1C;
		--slate-blue: #1E2A3A;
		--cream: #F8F6F1;
		--gold: #C9A962;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		height: 100%;
		overflow: hidden;
	}

	body {
		font-family: 'Outfit', sans-serif;
		background: var(--cream);
	}

	.split-container {
		display: flex;
		height: 100vh;
		position: relative;
	}

	.panel {
		flex: 1;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		color: white;
		overflow: hidden;
		cursor: pointer;
	}

	.panel-bg {
		position: absolute;
		inset: 0;
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.panel-left .panel-bg {
		background: linear-gradient(160deg, var(--cranberry) 0%, var(--cranberry-deep) 100%);
	}

	.panel-right .panel-bg {
		background: linear-gradient(200deg, var(--slate-blue) 0%, var(--midnight) 100%);
	}

	.panel:hover .panel-bg {
		transform: scale(1.05);
	}

	.panel-content {
		position: relative;
		z-index: 2;
		padding: 3rem;
		max-width: 400px;
		opacity: 1;
		transform: translateY(0);
		transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
	}


	.logo-container {
		margin-bottom: 2.5rem;
	}

	.logo {
		width: 180px;
		height: auto;
		opacity: 0.95;
	}

	.label {
		display: inline-block;
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		opacity: 0.6;
		margin-bottom: 1rem;
		border-bottom: 1px solid rgba(255,255,255,0.2);
		padding-bottom: 0.5rem;
	}

	.text-content h2 {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 400;
		line-height: 1.2;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.text-content p {
		font-size: 0.95rem;
		line-height: 1.7;
		opacity: 0.75;
		font-weight: 300;
		margin-bottom: 2rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.cta svg {
		transition: transform 0.3s ease;
	}

	.panel:hover .cta svg {
		transform: translateX(8px);
	}

	.hover-reveal {
		position: absolute;
		bottom: 4rem;
		left: 0;
		right: 0;
		z-index: 3;
		display: flex;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.hover-reveal span {
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: white;
		padding: 0.75rem 1.5rem;
		border: 1px solid rgba(255,255,255,0.4);
		border-radius: 100px;
		background: rgba(0,0,0,0.2);
		backdrop-filter: blur(10px);
		transform: translateY(10px);
		transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.panel:hover .hover-reveal {
		opacity: 1;
	}

	.panel:hover .hover-reveal span {
		transform: translateY(0);
	}

	/* Center Brand Element */
	.center-brand {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		z-index: 10;
		pointer-events: none;
	}

	.brand-vertical {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		background: var(--cream);
		padding: 2rem 1.5rem;
		border-radius: 100px;
		box-shadow: 0 20px 60px rgba(0,0,0,0.3);
	}

	.brand-text {
		font-family: 'Playfair Display', serif;
		font-size: 1rem;
		font-weight: 700;
		color: var(--midnight);
		writing-mode: vertical-rl;
		text-orientation: mixed;
		letter-spacing: 0.1em;
	}

	.brand-sub {
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--cranberry);
		writing-mode: vertical-rl;
		text-orientation: mixed;
	}

	footer {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		text-align: center;
		padding: 1.5rem;
		z-index: 10;
	}

	footer span {
		font-size: 0.65rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.4);
	}

	/* Animations */
	.panel-content {
		animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		opacity: 0;
	}

	.panel-left .panel-content {
		animation-delay: 0.2s;
	}

	.panel-right .panel-content {
		animation-delay: 0.4s;
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(40px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.center-brand {
		animation: scaleIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.8);
	}

	@keyframes scaleIn {
		to {
			opacity: 1;
			transform: translate(-50%, -50%) scale(1);
		}
	}

	/* Mobile */
	@media (max-width: 768px) {
		.split-container {
			flex-direction: column;
		}

		.center-brand {
			display: none;
		}

		.panel-content {
			padding: 2rem;
		}

		.logo {
			width: 140px;
		}

		.hover-reveal {
			bottom: 2rem;
		}
	}
</style>
